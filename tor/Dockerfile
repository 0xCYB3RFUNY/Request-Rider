FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251

# `tor` is pinned to an exact version. This package is not like the others in the
# image: Tor is what makes the outbound traffic anonymous, so a substituted or
# silently-upgraded build does not add a feature, it removes the one property the
# service exists to provide. The rest of the system is free to float.
#
# The version is the one bookworm ships; when it ages out of the archive the build
# fails loudly here instead of quietly installing something else.
ARG TOR_VERSION=0.4.9.11-0+deb12u1

# `ca-certificates` is not optional decoration, and `--no-install-recommends` is
# what made it disappear: tor lists it among Recommends, not Depends, so the
# flag installed tor without the CA bundle and `/etc/ssl/certs/ca-certificates.crt`
# did not exist in the image.
#
# Tor reaches every guard relay over TLS and validates its certificate against
# that bundle, so the missing file produced this, measured live on 2026-10-02:
#
#   Problem bootstrapping. Stuck at 10% (conn_done): Connected to a relay.
#   (unexpected eof while reading; TLS_ERROR; count 19;
#    recommendation warn; host 28A791F9E... at 96.9.98.186:443)
#   19 connections died in state handshaking (TLS) with SSL state error in HANDSHAKE
#
# The TCP connection opened and the TLS handshake died, every relay, count
# climbing — the signature of an empty trust store rather than a blocked port.
# It cannot bootstrap at all like this, and nothing in the container says why:
# the failure names relays, not certificates. The engine image installs the same
# package for the same reason and says so in its own build stage.
RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
         "tor=${TOR_VERSION}" \
         ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# `obfs4proxy` is what makes this container able to reach the network at all on a
# link that interferes with Tor.
#
# Measured 2026-10-02 on this machine: a direct connection to a relay opens the
# TCP socket and then dies inside the TLS handshake, on every relay tried, with
# the same signature from four independent angles:
#
#   tor:     Stuck at 10% (conn_done): Connected to a relay.
#            (unexpected eof while reading; TLS_ERROR; count 29 ...)
#   openssl: s_client -connect <relay>:443 -> unexpected eof while reading
#            (rec_layer_s3.c:698), four relays, same every time
#   control: plain HTTPS from the same host to an unrelated site answers 200/302
#   verdict: the socket opens and the handshake is cut. Not DNS, not a trust
#            store, not a port filter — so no version of ca-certificates fixes
#            it, and neither does retrying.
#
# obfs4 wraps that stream so it no longer looks like a TLS handshake at all.
# It is only useful together with bridge addresses, which is why `torrc` is
# generated by `docker-stand.sh` and bind-mounted: bridges change, they are
# per-network, and they must never be committed to this repository.
RUN apt-get update \
    && apt-get install --no-install-recommends --yes obfs4proxy \
    && rm -rf /var/lib/apt/lists/*

COPY torrc /etc/tor/torrc
RUN mkdir -p /var/lib/tor \
    && chown -R debian-tor:debian-tor /var/lib/tor

USER debian-tor
EXPOSE 9050
CMD ["tor", "-f", "/etc/tor/torrc"]
